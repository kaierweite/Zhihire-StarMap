<script setup lang="ts">
import { ref, reactive, onUnmounted } from 'vue'
import { ElMessage } from 'element-plus'
import {
  Upload, FileText, Check, RefreshCw, Edit, Trash2, Plus, X,
  ArrowRight, Save,
} from 'lucide-vue-next'

// ====== 状态 ======
type Phase = 'upload' | 'parsing' | 'result' | 'error'
const phase = ref<Phase>('upload')
const progress = ref(0)
const progressText = ref('')
const errorMsg = ref('')
let progressTimer: ReturnType<typeof setInterval> | null = null

// 解析结果数据
interface ParsedData {
  name: string
  education: string
  years: number
  targetJob: string
  city: string
  skills: string[]
  experience: { title: string; company: string; period: string; desc: string }[]
}

const parsedData = reactive<ParsedData>({
  name: '', education: '', years: 0, targetJob: '', city: '',
  skills: [], experience: [],
})

// 编辑状态
const editInfo = ref(false)
const editSkills = ref(false)
const editExp = ref(false)
const newSkill = ref('')
const editingExpIdx = ref(-1)
const hasChanges = ref(false)

// ====== 文件上传 ======
const allowedTypes = [
  'application/pdf',
  'application/msword',
  'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
]
const maxSize = 10 * 1024 * 1024 // 10MB

function handleFileChange(e: Event) {
  const input = e.target as HTMLInputElement
  const file = input.files?.[0]
  if (!file) return
  if (!allowedTypes.includes(file.type)) {
    ElMessage.error('仅支持 PDF / DOC / DOCX 格式')
    return
  }
  if (file.size > maxSize) {
    ElMessage.error('文件大小不能超过 10MB')
    return
  }
  startParse()
  input.value = ''
}

function handleDrop(e: DragEvent) {
  e.preventDefault()
  const file = e.dataTransfer?.files[0]
  if (!file) return
  if (!allowedTypes.includes(file.type)) {
    ElMessage.error('仅支持 PDF / DOC / DOCX 格式')
    return
  }
  if (file.size > maxSize) {
    ElMessage.error('文件大小不能超过 10MB')
    return
  }
  startParse()
}

// ====== 解析轮询（模拟，后续对接 API） ======
function startParse() {
  phase.value = 'parsing'
  progress.value = 0
  progressText.value = '正在上传简历...'

  // 模拟解析进度（实际应轮询 GET /api/parse/task/{id}）
  progressTimer = setInterval(() => {
    progress.value += Math.random() * 12 + 3
    if (progress.value > 92) progress.value = 92
    const remaining = Math.ceil((100 - progress.value) / 8)
    progressText.value = `正在解析中... 预计还需 ${remaining} 秒`
  }, 500)

  // 模拟 3 秒后完成（实际等 API 返回）
  setTimeout(() => {
    if (progressTimer) { clearInterval(progressTimer); progressTimer = null }
    progress.value = 100
    progressText.value = '解析完成'

    // 填充模拟数据（实际从 API 响应获取）
    Object.assign(parsedData, {
      name: '张三',
      education: '本科',
      years: 2,
      targetJob: '前端开发工程师',
      city: '成都',
      skills: ['Vue 3', 'TypeScript', 'React', 'Node.js', 'Python', 'SQL', 'Git'],
      experience: [
        { title: '前端开发实习生', company: '某科技有限公司', period: '2025.06 - 2025.12', desc: '负责公司内部管理系统的前端开发，使用 Vue 3 + Element Plus 构建 SPA。' },
        { title: '全栈开发（项目）', company: '个人项目', period: '2025.01 - 2025.05', desc: '独立开发了一个在线协作文档工具，前端 React + 后端 Node.js。' },
      ],
    })

    setTimeout(() => { phase.value = 'result' }, 400)
  }, 3000)
}

onUnmounted(() => { if (progressTimer) clearInterval(progressTimer) })

// ====== 编辑操作 ======
function removeSkill(idx: number) {
  parsedData.skills.splice(idx, 1)
  hasChanges.value = true
}

function addSkill() {
  const val = newSkill.value.trim()
  if (val && !parsedData.skills.includes(val)) {
    parsedData.skills.push(val)
    hasChanges.value = true
  }
  newSkill.value = ''
}

function deleteExp(idx: number) {
  parsedData.experience.splice(idx, 1)
  hasChanges.value = true
  if (editingExpIdx.value === idx) editingExpIdx.value = -1
}

function addExp() {
  parsedData.experience.push({ title: '新职位', company: '公司名称', period: '2024.01 - 至今', desc: '工作描述' })
  editingExpIdx.value = parsedData.experience.length - 1
  editExp.value = true
  hasChanges.value = true
}

function saveAll() {
  editInfo.value = false
  editSkills.value = false
  editExp.value = false
  editingExpIdx.value = -1
  hasChanges.value = false
  // TODO: 对接 PUT /api/resume 保存到后端
  ElMessage.success('保存成功')
}

function resetUpload() {
  phase.value = 'upload'
  progress.value = 0
  errorMsg.value = ''
  hasChanges.value = false
  editInfo.value = false
  editSkills.value = false
  editExp.value = false
}

// 技能标签颜色
const chipColors = ['chip-primary', 'chip-success', 'chip-neutral', 'chip-warning', 'chip-purple']
</script>

<template>
  <div class="resume-page">
    <div class="resume-container">
      <h1 class="page-title">简历中心</h1>

      <!-- ====== 上传区 ====== -->
      <div v-if="phase === 'upload'" class="upload-zone" @dragover.prevent @drop="handleDrop">
        <Upload :size="40" class="upload-icon" />
        <h3 class="upload-title">拖拽简历文件到此处，或点击上传</h3>
        <p class="upload-hint">支持 PDF / DOC / DOCX 格式，文件大小不超过 10MB</p>
        <label class="upload-btn">
          <FileText :size="16" /> 选择文件
          <input type="file" accept=".pdf,.doc,.docx" @change="handleFileChange" hidden />
        </label>
      </div>

      <!-- ====== 解析进度 ====== -->
      <div v-if="phase === 'parsing'" class="progress-card">
        <div class="progress-header">
          <RefreshCw :size="20" class="spinning" />
          <span class="progress-label">简历解析</span>
        </div>
        <div class="bar-track">
          <div class="bar-fill" :style="{ width: progress + '%' }" />
        </div>
        <p class="progress-text">{{ progressText }}</p>
      </div>

      <!-- ====== 解析失败 ====== -->
      <div v-if="phase === 'error'" class="error-card">
        <p class="error-msg">{{ errorMsg || '解析失败，请重试' }}</p>
        <button class="retry-btn" @click="resetUpload">
          <RefreshCw :size="14" /> 重新解析
        </button>
      </div>

      <!-- ====== 解析结果 ====== -->
      <div v-if="phase === 'result'" class="result-area">
        <!-- 操作栏 -->
        <div class="result-actions">
          <div class="action-left">
            <button class="action-btn" @click="resetUpload"><RefreshCw :size="14" /> 重新上传</button>
          </div>
          <div class="action-right">
            <button v-if="hasChanges" class="save-btn" @click="saveAll"><Save :size="14" /> 保存修改</button>
          </div>
        </div>

        <!-- 基本信息 -->
        <section class="result-section">
          <div class="section-head">
            <h2>基本信息</h2>
            <button class="edit-toggle" @click="editInfo = !editInfo">
              <component :is="editInfo ? X : Edit" :size="14" />
            </button>
          </div>
          <div v-if="!editInfo" class="info-grid">
            <div class="info-item"><span class="info-label">姓名</span><span class="info-value">{{ parsedData.name || '未填写' }}</span></div>
            <div class="info-item"><span class="info-label">学历</span><span class="info-value">{{ parsedData.education || '未填写' }}</span></div>
            <div class="info-item"><span class="info-label">工作年限</span><span class="info-value">{{ parsedData.years ? parsedData.years + '年' : '未填写' }}</span></div>
            <div class="info-item"><span class="info-label">目标职位</span><span class="info-value">{{ parsedData.targetJob || '未填写' }}</span></div>
            <div class="info-item"><span class="info-label">期望城市</span><span class="info-value">{{ parsedData.city || '未填写' }}</span></div>
          </div>
          <div v-else class="info-edit-grid">
            <label class="edit-field"><span>姓名</span><input v-model="parsedData.name" @input="hasChanges = true" /></label>
            <label class="edit-field"><span>学历</span><input v-model="parsedData.education" @input="hasChanges = true" /></label>
            <label class="edit-field"><span>工作年限</span><input v-model.number="parsedData.years" type="number" @input="hasChanges = true" /></label>
            <label class="edit-field"><span>目标职位</span><input v-model="parsedData.targetJob" @input="hasChanges = true" /></label>
            <label class="edit-field"><span>期望城市</span><input v-model="parsedData.city" @input="hasChanges = true" /></label>
          </div>
        </section>

        <!-- 专业技能 -->
        <section class="result-section">
          <div class="section-head">
            <h2>专业技能</h2>
            <button class="edit-toggle" @click="editSkills = !editSkills">
              <component :is="editSkills ? X : Edit" :size="14" />
            </button>
          </div>
          <div class="skills-list">
            <span v-for="(skill, i) in parsedData.skills" :key="skill" class="skill-chip" :class="chipColors[i % chipColors.length]">
              {{ skill }}
              <button v-if="editSkills" class="chip-remove" @click="removeSkill(i)"><X :size="10" /></button>
            </span>
          </div>
          <div v-if="editSkills" class="add-skill-row">
            <input v-model="newSkill" placeholder="输入技能名称" @keydown.enter="addSkill" class="skill-input" />
            <button class="add-skill-btn" @click="addSkill">添加</button>
          </div>
        </section>

        <!-- 工作经历 -->
        <section class="result-section">
          <div class="section-head">
            <h2>工作 / 项目经历</h2>
            <button class="edit-toggle" @click="editExp = !editExp; editingExpIdx = -1">
              <component :is="editExp ? X : Edit" :size="14" />
            </button>
          </div>
          <div v-if="parsedData.experience.length" class="exp-list">
            <div v-for="(exp, i) in parsedData.experience" :key="i" class="exp-item">
              <!-- 查看模式 -->
              <template v-if="!editExp || editingExpIdx !== i">
                <div class="exp-dot" />
                <div class="exp-content">
                  <div class="exp-title-row">
                    <span class="exp-title">{{ exp.title }}</span>
                    <span class="exp-period">{{ exp.period }}</span>
                  </div>
                  <div class="exp-company">{{ exp.company }}</div>
                  <p class="exp-desc">{{ exp.desc }}</p>
                </div>
                <div v-if="editExp" class="exp-edit-btns">
                  <button class="icon-btn-sm" @click="editingExpIdx = i"><Edit :size="13" /></button>
                  <button class="icon-btn-sm danger" @click="deleteExp(i)"><Trash2 :size="13" /></button>
                </div>
              </template>
              <!-- 编辑模式 -->
              <template v-else>
                <div class="exp-edit-form">
                  <div class="edit-row">
                    <input v-model="exp.title" placeholder="职位" @input="hasChanges = true" />
                    <input v-model="exp.company" placeholder="公司" @input="hasChanges = true" />
                  </div>
                  <input v-model="exp.period" placeholder="时间段" @input="hasChanges = true" />
                  <textarea v-model="exp.desc" placeholder="工作描述" rows="2" @input="hasChanges = true" />
                  <div class="edit-form-actions">
                    <button class="confirm-btn" @click="editingExpIdx = -1">确认</button>
                    <button class="cancel-btn" @click="editingExpIdx = -1">取消</button>
                  </div>
                </div>
              </template>
            </div>
          </div>
          <button v-if="editExp" class="add-exp-btn" @click="addExp">
            <Plus :size="16" /> 添加工作经历
          </button>
        </section>

        <!-- 前往职位推荐 -->
        <div class="go-recommend">
          <router-link to="/user/jobs" class="recommend-btn">
            查看推荐职位 <ArrowRight :size="16" />
          </router-link>
        </div>
      </div>
    </div>
  </div>
</template>

<style scoped lang="scss">
.resume-page { padding: 24px 16px; }
.resume-container { max-width: 800px; margin: 0 auto; }

.page-title {
  font-size: 24px; font-weight: 700; color: #303133; margin-bottom: 24px;
}

/* ====== 上传区 ====== */
.upload-zone {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 60px 24px; border: 2px dashed #dcdfe6; border-radius: 12px;
  background: #fff; transition: all 0.3s; cursor: pointer;
  &:hover { border-color: #1a3a5c; background: rgba(26,58,92,0.02); }
}
.upload-icon { color: #c0c4cc; margin-bottom: 16px; }
.upload-title { font-size: 16px; font-weight: 600; color: #303133; margin-bottom: 8px; }
.upload-hint { font-size: 13px; color: #909399; margin-bottom: 20px; }
.upload-btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 10px 28px; border-radius: 999px; background: #1a3a5c; color: #fff;
  font-size: 14px; font-weight: 600; cursor: pointer; transition: all 0.3s;
  &:hover { background: #24507a; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(26,58,92,0.2); }
}

/* ====== 进度 ====== */
.progress-card {
  background: #fff; border-radius: 12px; padding: 32px; border: 1px solid #e5e7eb;
}
.progress-header { display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
.progress-label { font-size: 16px; font-weight: 600; color: #303133; }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.spinning { color: #1a3a5c; animation: spin 1s linear infinite; }
.bar-track { height: 8px; border-radius: 999px; background: #e9ecef; overflow: hidden; margin-bottom: 12px; }
.bar-fill { height: 100%; border-radius: 999px; background: linear-gradient(90deg, #1a3a5c, #0ea5e9); transition: width 0.4s ease; }
.progress-text { font-size: 13px; color: #909399; }

/* ====== 错误 ====== */
.error-card {
  background: #fff; border-radius: 12px; padding: 32px; border: 1px solid #f56c6c;
  text-align: center;
}
.error-msg { color: #f56c6c; font-size: 14px; margin-bottom: 16px; }
.retry-btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 8px 20px; border-radius: 999px; border: 1px solid #1a3a5c;
  background: none; color: #1a3a5c; font-size: 13px; font-weight: 600; cursor: pointer;
  transition: all 0.2s;
  &:hover { background: #1a3a5c; color: #fff; }
}

/* ====== 结果区 ====== */
.result-actions {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16px;
}
.action-btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 6px 16px; border-radius: 6px; border: 1px solid #dcdfe6;
  background: #fff; color: #606266; font-size: 13px; cursor: pointer;
  transition: all 0.2s;
  &:hover { border-color: #1a3a5c; color: #1a3a5c; }
}
.save-btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 8px 20px; border-radius: 999px; background: #1a3a5c; color: #fff;
  font-size: 13px; font-weight: 600; border: none; cursor: pointer;
  transition: all 0.2s;
  &:hover { background: #24507a; }
}

.result-section {
  background: #fff; border-radius: 12px; padding: 24px; margin-bottom: 16px; border: 1px solid #e5e7eb;
}
.section-head {
  display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;
  h2 { font-size: 18px; font-weight: 700; color: #303133; }
}
.edit-toggle {
  width: 32px; height: 32px; border-radius: 8px; border: 1px solid #dcdfe6;
  background: #fff; color: #909399; display: flex; align-items: center; justify-content: center;
  cursor: pointer; transition: all 0.2s;
  &:hover { border-color: #1a3a5c; color: #1a3a5c; }
}

/* 基本信息 */
.info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 32px; }
.info-item { display: flex; align-items: center; font-size: 14px; }
.info-label { color: #909399; width: 70px; flex-shrink: 0; }
.info-value { color: #303133; }

.info-edit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 24px; }
.edit-field {
  display: flex; flex-direction: column; gap: 4px;
  span { font-size: 12px; color: #909399; }
  input {
    padding: 6px 10px; border: 1px solid #dcdfe6; border-radius: 6px;
    font-size: 13px; color: #303133; outline: none; transition: border-color 0.2s;
    &:focus { border-color: #1a3a5c; box-shadow: 0 0 0 2px rgba(26,58,92,0.08); }
  }
}

/* 技能 */
.skills-list { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
.skill-chip {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 4px 14px; border-radius: 4px; font-size: 12px; font-weight: 600; letter-spacing: 0.3px;
}
.chip-primary { background: #dbeafe; color: #1e3a8a; }
.chip-success { background: #d4edda; color: #155724; }
.chip-neutral { background: #f3f4f5; color: #434656; }
.chip-warning { background: #fff3cd; color: #856404; }
.chip-purple { background: #e8d5f5; color: #6a1b9a; }
.chip-remove {
  width: 16px; height: 16px; border-radius: 50%; background: rgba(0,0,0,0.12);
  display: inline-flex; align-items: center; justify-content: center;
  cursor: pointer; transition: background 0.2s; border: none; color: inherit; padding: 0;
  &:hover { background: rgba(220,53,69,0.25); }
}

.add-skill-row { display: flex; gap: 8px; margin-top: 8px; }
.skill-input {
  flex: 1; padding: 6px 10px; border: 1px solid #dcdfe6; border-radius: 6px;
  font-size: 13px; outline: none;
  &:focus { border-color: #1a3a5c; }
}
.add-skill-btn {
  padding: 6px 16px; border-radius: 6px; background: #1a3a5c; color: #fff;
  font-size: 12px; font-weight: 600; border: none; cursor: pointer;
  transition: background 0.2s;
  &:hover { background: #24507a; }
}

/* 经历 */
.exp-list { position: relative; }
.exp-item {
  position: relative; padding-left: 24px; padding-bottom: 20px;
  border-left: 2px solid #e5e7eb; margin-left: 6px;
  &:last-child { border-left-color: transparent; padding-bottom: 0; }
}
.exp-dot {
  position: absolute; left: -5px; top: 6px; width: 8px; height: 8px;
  border-radius: 50%; background: #1a3a5c;
}
.exp-content { padding-left: 8px; }
.exp-title-row { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 2px; }
.exp-title { font-size: 15px; font-weight: 600; color: #303133; }
.exp-period { font-size: 12px; color: #909399; }
.exp-company { font-size: 13px; color: #0ea5e9; font-weight: 500; margin-bottom: 4px; }
.exp-desc { font-size: 13px; color: #606266; line-height: 1.6; }

.exp-edit-btns {
  position: absolute; right: 0; top: 0; display: flex; gap: 4px;
}
.icon-btn-sm {
  width: 28px; height: 28px; border-radius: 6px; border: 1px solid #dcdfe6;
  background: #fff; color: #909399; display: flex; align-items: center; justify-content: center;
  cursor: pointer; transition: all 0.2s;
  &:hover { border-color: #1a3a5c; color: #1a3a5c; }
  &.danger:hover { border-color: #f56c6c; color: #f56c6c; }
}

.exp-edit-form {
  padding-left: 8px; display: flex; flex-direction: column; gap: 8px;
  .edit-row { display: flex; gap: 8px; }
  input, textarea {
    width: 100%; padding: 6px 10px; border: 1px solid #dcdfe6; border-radius: 6px;
    font-size: 13px; color: #303133; outline: none; font-family: inherit;
    &:focus { border-color: #1a3a5c; }
  }
  textarea { resize: vertical; }
}
.edit-form-actions { display: flex; gap: 8px; }
.confirm-btn {
  padding: 6px 16px; border-radius: 6px; background: #1a3a5c; color: #fff;
  font-size: 12px; font-weight: 600; border: none; cursor: pointer;
  &:hover { background: #24507a; }
}
.cancel-btn {
  padding: 6px 16px; border-radius: 6px; background: #fff; color: #606266;
  font-size: 12px; border: 1px solid #dcdfe6; cursor: pointer;
  &:hover { border-color: #1a3a5c; color: #1a3a5c; }
}

.add-exp-btn {
  display: flex; align-items: center; justify-content: center; gap: 6px;
  width: 100%; padding: 12px; border: 2px dashed #dcdfe6; border-radius: 8px;
  background: none; color: #909399; font-size: 13px; cursor: pointer;
  margin-top: 12px; transition: all 0.2s;
  &:hover { border-color: #1a3a5c; color: #1a3a5c; }
}

.go-recommend { text-align: center; margin-top: 24px; }
.recommend-btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 36px; border-radius: 999px; background: #1a3a5c; color: #fff;
  font-size: 15px; font-weight: 600; text-decoration: none; transition: all 0.3s;
  &:hover { background: #24507a; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(26,58,92,0.2); text-decoration: none; }
}

@media (max-width: 640px) {
  .info-grid, .info-edit-grid { grid-template-columns: 1fr; }
  .exp-title-row { flex-direction: column; }
}
</style>
