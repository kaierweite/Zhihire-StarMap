# ============================================================
# 智聘星图 后端环境变量模板
# 复制为 .env 并按实际环境填写。KingbaseES 兼容 PostgreSQL，使用 asyncpg 驱动。
# ============================================================

# ---- 应用基础信息 ----
APP_NAME=智聘星图
APP_ENV=dev
API_PREFIX=/api

# ---- 数据库连接（KingbaseES 占位，PG 兼容 asyncpg）----
# 格式：postgresql+asyncpg://用户名:密码@主机:端口/库名
DATABASE_URL=postgresql+asyncpg://kingbase:kingbase@127.0.0.1:54321/starmap
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ---- JWT 认证（生产请替换为强随机串）----
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- DeepSeek 云端大模型 ----
# 留空时客户端走 mock 逻辑，便于无网络本地开发
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60

# ---- 文件本地存储 ----
FILE_STORAGE_DIR=./storage/uploads
FILE_BASE_URL=/files

# ---- 缓存后端：memory / redis ----
CACHE_BACKEND=memory

# ---- CORS 跨域来源（逗号分隔）----
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]